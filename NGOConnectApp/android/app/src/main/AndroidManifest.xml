<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- File download: write to Downloads folder on Android 9 and below (API 28-) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Push notifications: required on Android 13+ (API 33+) for FCM banners to appear -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Image picker: READ_EXTERNAL_STORAGE covers Android 12 and below (API 32-).
         Android 13+ (API 33+) uses the system Photo Picker via react-native-image-picker
         which requires no broad storage permission — READ_MEDIA_IMAGES removed per
         Google Play Photo and Video Permissions policy. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Geolocation: show nearby NGOs and opportunities -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">

      <!-- FCM: use our white monochrome icon for the status bar (not the coloured launcher icon).
           tools:replace overrides the default declared by react-native-firebase_messaging. -->
      <meta-data
          android:name="com.google.firebase.messaging.default_notification_icon"
          android:resource="@drawable/ic_notification"
          tools:replace="android:resource" />
      <!-- FCM: accent colour shown in the notification drawer on Android 5+.
           tools:replace overrides @color/white declared by react-native-firebase_messaging. -->
      <meta-data
          android:name="com.google.firebase.messaging.default_notification_color"
          android:resource="@color/notification_color"
          tools:replace="android:resource" />

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <!-- Custom URI scheme: ngoconnect://invite/{token} -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="ngoconnect" />
        </intent-filter>

        <!-- App Links (HTTPS): all supported deep link paths on all production hosts.
             Multiple <data> host entries in a single intent-filter are OR'd by Android:
             any of the three hosts × any of the listed path prefixes triggers this filter.
             android:autoVerify="true" makes Android verify assetlinks.json on ALL three hosts
             at install time — the key must appear at /.well-known/assetlinks.json on each. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <!-- Hosts: bare domain, www, and staging -->
            <data android:scheme="https" android:host="ripplehub.app" />
            <data android:scheme="https" android:host="www.ripplehub.app" />
            <data android:scheme="https" android:host="stage.ripplehub.app" />
            <!-- Supported path prefixes -->
            <data android:pathPrefix="/invite/" />
            <data android:pathPrefix="/ngo/" />
            <data android:pathPrefix="/organisation/" />
            <data android:pathPrefix="/opportunity/" />
            <data android:pathPrefix="/post/" />
        </intent-filter>
      </activity>
    </application>
</manifest>
